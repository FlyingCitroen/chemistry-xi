# Copy to .env (never commit .env). Leave empty to run in template mode.
AZURE_OPENAI_ENDPOINT=https://<your-resource>.openai.azure.com/
AZURE_OPENAI_API_KEY=<key>
AZURE_OPENAI_DEPLOYMENT=<your-chat-deployment-name>
# AZURE_OPENAI_API_VERSION=2024-10-21

# Free alternative when Azure is unavailable (PAT with Models: read-only):
# GITHUB_MODELS_TOKEN=<github-pat>
# GITHUB_MODELS_MODEL=openai/gpt-4o-mini   # check github.com/marketplace/models for exact names
